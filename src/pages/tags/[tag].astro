---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getDiscoveryTags } from '../../utils/tags';

export async function getStaticPaths() {
  const allPosts = await getCollection('weekly');
  
  // Get all unique tags
  const uniqueTags = [...new Set(allPosts.flatMap(post => getDiscoveryTags(post.data.tags)))];
  
  // Create a path for each tag
  return uniqueTags.map(tag => {
    const filteredPosts = allPosts.filter(post =>
      getDiscoveryTags(post.data.tags).includes(tag)
    );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

// Sort posts by date
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Format posts for the PostList component
const formattedPosts = sortedPosts.map(post => ({
  ...post,
  url: `/weekly/${post.id}`,
  frontmatter: post.data
}));
---

<BaseLayout title={`标签为"${tag}"的周刊`}>
  <div class="max-w-3xl mx-auto">
    <header class="mb-12 text-center">
      <h1 class="text-5xl mb-4">标签：{tag}</h1>
      <p class="text-xl text-muted-foreground">
        共 {posts.length} 期周刊包含“{tag}”
      </p>
    </header>

    <PostList posts={formattedPosts} />
    
    <div class="mt-12 text-center">
      <a href="/journal" class="cta-button">
        查看所有周刊
      </a>
    </div>
  </div>
</BaseLayout>
